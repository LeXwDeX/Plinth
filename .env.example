# Plinth self-deploy settings for docker-compose.yml.
#   cp .env.example .env && chmod 600 .env
# Fill the two required values below (README.md "Docker Compose 自部署" step 1
# has a command that generates both), then:
#   ART_AI_SOURCE_COMMIT=$(git rev-parse HEAD) docker compose up -d --build --wait
# and sign in at http://127.0.0.1:13333/ as ADMIN_USERNAME / ADMIN_PASSWORD.
# Everything else has a working default: with no Provider key the mock mode
# below still generates sample images and 3D models.
# Never commit .env. See README.md and docs/self-deploy-security.md.

# ---- Required ---------------------------------------------------------------
# Signs login sessions. At least 32 characters; changing it signs everyone out.
# Generate: openssl rand -base64 48
SESSION_SECRET=
# Password of the first admin (ADMIN_USERNAME below), created on the first start
# when that user does not exist yet. At least 6 characters; use a long random one.
# Generate: openssl rand -base64 24
ADMIN_PASSWORD=

# ---- Network ----------------------------------------------------------------
# Host address and port the service listens on. 127.0.0.1 keeps it on this
# machine (put a reverse proxy in front); 0.0.0.0 exposes it on every interface.
ART_AI_BIND_IP=127.0.0.1
ART_AI_PORT=13333
# Public https URL when served behind a reverse proxy; an https URL marks the
# session cookie Secure. Leave empty for plain-HTTP local use.
NEXT_PUBLIC_APP_URL=
# Reverse proxies whose X-Forwarded-For names the client (CIDRs or addresses).
# Empty trusts no forwarding header. See docs/self-deploy-security.md.
TRUSTED_PROXY_CIDRS=

# ---- First admin --------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrator
ADMIN_EMAIL=admin@example.invalid
# The admin is created only when missing; a password changed in the product is
# kept. Set to true and run `docker compose up -d --wait` to overwrite it with
# ADMIN_PASSWORD (also signs out this admin's sessions). Then set it back to
# false and run `docker compose up -d --wait` again; restart does not refresh env.
ADMIN_PASSWORD_RESET=false

# ---- Generation ---------------------------------------------------------------
# mock: built-in sample results, no upstream calls, no keys, no cost.
# live: call the Providers whose keys are set below (they spend credits).
PROVIDER_MODE=mock
AGENT_MODE=mock

# Only needed when an upstream Provider must fetch an asset from this server by
# URL: the server's public https base URL plus an HMAC key of at least 32 bytes
# (openssl rand -base64 48). Set both or neither.
PUBLIC_BASE_URL=
ASSET_SIGNING_KEY=

# A Provider is enabled by its own <ID>_API_KEY; an empty <ID>_BASE_URL uses its
# default. Keys spend that account's credits. See docs/provider-configuration.md.
# Each address belongs to one connection and never falls back to another:
# OPENAI_BASE_URL is OpenAI images (empty = official OpenAI URL), GEMINI_BASE_URL
# is Gemini images (no default: required with GEMINI_API_KEY, otherwise Gemini
# stays not configured). LLM_BASE_URL below is the Agent's chat model only.
# Unified gateway: when one LLM API gateway serves every model, set
# LLM_BASE_URL, OPENAI_BASE_URL and GEMINI_BASE_URL all to the gateway URL,
# each one explicitly.
OPENAI_BASE_URL=
OPENAI_API_KEY=
GEMINI_BASE_URL=
GEMINI_API_KEY=
JIMENG_BASE_URL=
JIMENG_API_KEY=
MESHY_BASE_URL=
MESHY_API_KEY=
TRIPO_BASE_URL=
TRIPO_API_KEY=
HYPER3D_BASE_URL=
HYPER3D_API_KEY=
MATTING_BASE_URL=
MATTING_API_KEY=

# The Agent's chat model (AGENT_MODE=live): an OpenAI-compatible chat
# completions endpoint. REQUIRED for AGENT_MODE=live: LLM_BASE_URL (no default,
# e.g. https://api.deepseek.com/v1) and LLM_API_KEY. Without the URL
# or key the Agent shows as "not configured".
LLM_BASE_URL=
LLM_API_KEY=
# Set the model name your endpoint serves. Empty falls back to the Schema's
# "deepseek", an alias only the project's llms gateway knows.
LLM_MODEL=
# More chat models people can pick in the composer (#322): list connection IDs,
# comma separated (e.g. QWEN,GLM). Connection <ID> reads only <ID>_BASE_URL,
# <ID>_API_KEY, <ID>_MODEL and optionally <ID>_CONTEXT_WINDOW_TOKENS; nothing
# falls back to LLM_*. Administrators choose the offered models, the default
# and the thinking levels on the admin page "LLM settings".
LLM_CONNECTIONS=
# Tool calls one Agent reply may run before it summarises and asks you to
# continue (each new reply starts at 0). Empty keeps the default 20; 1..100.
AGENT_MAX_TOOL_CALLS_PER_REPLY=

# ---- Logs -------------------------------------------------------------------
# debug | info | warn | error. Logs go to the container output (docker compose logs).
LOG_LEVEL=info

# ---- Build (optional) ---------------------------------------------------------
# COMPOSE_PROJECT_NAME=art-ai
# ART_AI_IMAGE_TAG=local
# Full commit SHA reported by /api/version (else "unknown"). Pass it per build
# instead of storing it here: ART_AI_SOURCE_COMMIT=$(git rev-parse HEAD) docker compose up -d --build --wait
# ART_AI_SOURCE_COMMIT=
# Go module proxy for the build (npm uses the public registry.npmjs.org). Only set it for a mirror.
# GOPROXY=https://proxy.golang.org,direct

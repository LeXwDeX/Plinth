{
  "version": 1,
  "acceptance": {
    "forge_repo": "<owner>/<repo>",
    "forge_url": "https://github.com/<owner>/<repo>",
    "issue": 0
  },
  "environments": {
    "dev-test": {
      "description": "开发/测试环境：每次发布已推送的 origin/main，跑完整 L0/L1/L1 Agent 与相关验收",
      "ssh": "root@<dev-test-host>",
      "root": "<dev-test-release-root>",
      "base_url": "http://<dev-test-host>:<port>",
      "compose_project": "<dev-test-compose-project>",
      "protect_projects": ["<candidate-compose-project>"],
      "protected_paths": ["<legacy-root>"],
      "data": "ephemeral",
      "host_ci": {
        "dir": "<host-ci-directory-outside-every-release-root>"
      },
      "build": {
        "add_hosts": ["<registry-host>:<registry-address>"]
      },
      "layout": {
        "GO_LEGACY_GENERATED_IMAGES_DIR": "<legacy-root>/storage/generated",
        "GO_LEGACY_ASSET_CACHE_DIR": "<legacy-root>/storage/cache",
        "GO_LEGACY_THUMBNAIL_CACHE_DIR": "<legacy-root>/storage/thumbnails",
        "GO_LEGACY_INPUT_ASSETS_DIR": "<legacy-root>/storage/assets"
      }
    },
    "prod": {
      "description": "prod：只接收 dev-test 已稳定通过全部验收的精确 revision；全量备份只保留 1 份；日志按大小滚动加按天数清理、保留 14 天，须在该环境的运行环境文件 production/runtime.env 里设 LOG_RETENTION_DAYS=14（layout 只收主机路径与端口，不能传它）；layout 里的 MCP_PUBLIC_BIND_IP 与 MCP_PUBLIC_HOST_PORT 是可选键，只在要对局域网开放外部 MCP 监听时才写（见 docs/deployment.md）",
      "ssh": "root@<prod-host>",
      "root": "<prod-release-root>",
      "base_url": "http://<prod-host>:<port>",
      "compose_project": "<prod-compose-project>",
      "protected_paths": [],
      "promote_from": "dev-test",
      "backup": {"scope": "full", "keep": 1},
      "extra_compose_file": "<prod-release-root>/production/compose.network.yml",
      "source_transfer": "scp",
      "build": {
        "network": "host",
        "goproxy": "<internal Go proxy URL>",
        "add_hosts": ["<registry-host>:<registry-address>"]
      },
      "single_stack": {
        "image_keep": 1,
        "keep_source_snapshots": 1,
        "allow_bootstrap": true
      },
      "layout": {
        "GO_WEB_BIND_IP": "<prod-host>",
        "GO_WEB_HOST_PORT": "<port>",
        "MCP_PUBLIC_BIND_IP": "<prod-host>",
        "MCP_PUBLIC_HOST_PORT": "<mcp-port>",
        "GO_PROD_DB_DIR": "<prod-release-root>/production/data",
        "GO_PROD_STORAGE_DIR": "<prod-release-root>/production/storage-go",
        "GO_PROD_WEB_DATA_DIR": "<prod-release-root>/production/web-data",
        "GO_PROD_LOG_DIR": "<prod-release-root>/production/logs",
        "GO_LEGACY_GENERATED_IMAGES_DIR": "<prod-release-root>/production/legacy-generated",
        "GO_LEGACY_ASSET_CACHE_DIR": "<prod-release-root>/production/legacy-cache",
        "GO_LEGACY_THUMBNAIL_CACHE_DIR": "<prod-release-root>/production/legacy-thumbnails",
        "GO_LEGACY_INPUT_ASSETS_DIR": "<prod-release-root>/production/legacy-assets"
      }
    }
  }
}
